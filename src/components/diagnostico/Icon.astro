---
import { ICONS, type IconName } from '../../lib/diagnostico/icons';

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: cls = 'w-5 h-5' } = Astro.props;
---

<svg
  class={cls}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={ICONS[name]}
/>
